import os
import asyncio
from dotenv import load_dotenv
from langchain_openai import ChatOpenAI
from langchain_mcp import MCPToolkit
from deepagents import create_deep_agent

# Load variables from .env
load_dotenv()

async def run_agent():
    # 1. Initialize your local Qwen model via Open WebUI
    print("Initializing Qwen model...")
    qwen_llm = ChatOpenAI(
        model="qwen36-35b", # Ensure this matches your exact Open WebUI model tag
        api_key=os.getenv("OPENWEBUI_API_KEY"),
        base_url=os.getenv("OPENWEBUI_BASE_URL"),
        max_tokens=2048,
    )

    # 2. Connect to the Grafana MCP server over the internal Docker network
    # The streamable-http mode exposes an SSE endpoint at /sse
    mcp_url = os.getenv("MCP_SERVER_URL", "http://grafana-mcp:8000/sse")
    print(f"Connecting to Grafana MCP at {mcp_url}...")
    
    # Initialize the toolkit using SSE transport
    grafana_toolkit = MCPToolkit(server_url=mcp_url, transport="sse")
    await grafana_toolkit.initialize()
    grafana_tools = grafana_toolkit.get_tools()
    
    print(f"Successfully loaded {len(grafana_tools)} tools from Grafana.")

    # 3. Define the CCAST System Prompt
    system_prompt = """
    You are the CCAST AI Monitoring Assistant. Your job is to help the systems team query 
    and interpret telemetry data across our HPC clusters using Grafana.
    
    When asked about infrastructure:
    1. Use your Grafana tools to fetch relevant dashboards or metrics.
    2. Analyze the time-series data.
    3. Provide a clear summary of the hardware state.
    """

    # 4. Create the Deep Agent
    monitoring_agent = create_deep_agent(
        model=qwen_llm,
        tools=grafana_tools,
        system_prompt=system_prompt
    )

    # 5. Run a test query to verify the deployment
    print("Sending test query to agent...")
    test_prompt = "What dashboards are available to monitor node health and Infiniband switches?"
    
    response = await monitoring_agent.ainvoke({
        "messages": [{"role": "user", "content": test_prompt}]
    })

    print("\n=== Agent Response ===")
    print(response["messages"][-1]["content"])
    print("======================\n")

if __name__ == "__main__":
    asyncio.run(run_agent())
